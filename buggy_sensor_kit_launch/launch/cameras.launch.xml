<launch>
  <!-- Back Camera -->
  <node pkg="usb_cam" 
        exec="usb_cam_node_exe" 
        name="usb_cam_back"
        namespace="camera_back">
    <param name="params_file" value="$(find-pkg-share buggy_sensor_kit_launch)/config/camera_configuration/back.yaml"/>
    <remap from="image_raw" to="/sensing/camera/camera0/image_rect_color"/>
    <remap from="image_raw/compressed" to="/sensing/camera/camera0/compressed"/>
    <remap from="image_raw/compressedDepth" to="/sensing/camera/camera0/compressedDepth"/>
    <remap from="image_raw/theora" to="/sensing/camera/camera0/theora"/>
    <remap from="camera_info" to="/sensing/camera/camera0/camera_info"/>
  </node>
</launch>
