<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="host_ip" default="192.168.1.10"/>
  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>

  <arg name="launch_tmlidar_top" default="false"/>
  <arg name="launch_tmlidar_left" default="false"/>
  <arg name="launch_tmlidar_right" default="false"/>

  <arg name="launch_rslidar_top" default="true"/>
  <arg name="launch_rslidar_left" default="true"/>
  <arg name="launch_rslidar_right" default="true"/>

  <group>
    <push-ros-namespace namespace="lidar"/>
    <group if="$(var launch_tmlidar_top)">
      <push-ros-namespace namespace="top"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml">
        <arg name="max_range" value="250.0"/>
        <arg name="sensor_frame" value="velodyne_top"/>
        <arg name="sensor_ip" value="192.168.1.201"/>
        <arg name="host_ip" value="192.168.1.106"/>
        <arg name="data_port" value="2367"/>
        <arg name="scan_phase" value="300.0"/>
        <arg name="cloud_min_angle" value="0"/>
        <arg name="cloud_max_angle" value="360"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="$(var pointcloud_container_name)"/>
        <arg name="min_range" value="0.5"/>
      </include>
    </group>

    <group if="$(var launch_tmlidar_left)">
      <push-ros-namespace namespace="left"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml">
        <arg name="max_range" value="250.0"/>
        <arg name="sensor_frame" value="velodyne_left"/>
        <arg name="sensor_ip" value="192.168.1.201"/>
        <arg name="host_ip" value="192.168.1.107"/>
        <arg name="data_port" value="2369"/>
        <arg name="scan_phase" value="300.0"/>
        <arg name="cloud_min_angle" value="190"/>
        <arg name="cloud_max_angle" value="90"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="$(var pointcloud_container_name)"/>
      </include>
    </group>

    <group if="$(var launch_tmlidar_right)">
      <push-ros-namespace namespace="right"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml">
        <arg name="max_range" value="250.0"/>
        <arg name="sensor_frame" value="velodyne_right"/>
        <arg name="sensor_ip" value="192.168.1.201"/>
        <arg name="host_ip" value="192.168.1.105"/>
        <arg name="data_port" value="2368"/>
        <arg name="scan_phase" value="300.0"/>
        <arg name="cloud_min_angle" value="270"/>
        <arg name="cloud_max_angle" value="170"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="$(var pointcloud_container_name)"/>
      </include>
    </group>

    <group if="$(var launch_rslidar_top)">
      <push-ros-namespace namespace="top"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/robosense_RS32.launch.xml">
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="sensor_frame" value="velodyne_top"/>
      </include>
    </group>

    <group if="$(var launch_rslidar_left)">
      <push-ros-namespace namespace="left"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/robosense_RS32.launch.xml">
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="sensor_frame" value="velodyne_left"/>
      </include>
    </group>

    <group if="$(var launch_rslidar_right)">
      <push-ros-namespace namespace="right"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/robosense_RS32.launch.xml">
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="sensor_frame" value="velodyne_right"/>
      </include>
    </group>

    <group if="$(eval '\'$(var launch_rslidar_top)\' == \'true\' or \'$(var launch_rslidar_left)\' == \'true\' or \'$(var launch_rslidar_right)\' == \'true\'')">
      <include file="$(find-pkg-share rslidar_sdk)/launch/start.launch.py">
        <arg name="buggy_no" value="2"/>
      </include>
    </group>

    <include file="$(find-pkg-share buggy_sensor_kit_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="container_name" value="$(var pointcloud_container_name)"/>
    </include>
  </group>
</launch>
